# Toolchain image for the Cloud Build pipeline of kit.
#
# cloudbuild/builder.yaml builds and pushes this image. cloudbuild/ci.yaml,
# cloudbuild/supply.yaml and cloudbuild/connect-latest.yaml run it, so each
# step calls `cargo` directly and installs no tool. The image gives:
#   - one place that pins every tool version,
#   - the same environment on every run,
#   - sccache from the start, so RUSTC_WRAPPER never points at a missing tool.
#
# Rebuild the image (run cloudbuild/builder.yaml) when this file or
# rust/rust-toolchain.toml changes. cloudbuild/builder.yaml reads the version
# from that file and passes it as RUST_VERSION. The image tag (rust-<version>)
# is the version contract. Change it together with the _CI_IMAGE default in
# every cloudbuild/*.yaml file. scripts/test-ci-gates.py checks that they agree.
ARG RUST_VERSION
FROM rust:${RUST_VERSION}-bookworm

# clang: the wasm32 build of kit-client compiles the zstd C library.
# git: the writing and generated-code checks read the repository.
# python3-venv, python3-pip: the golden checks install their Python packages.
# mold: links the nextest archive (cloudbuild/ci.yaml).
# unzip: unpacks protoc below.
# xz-utils: unpacks the Node tarball below.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        clang git jq mold pkg-config python3-pip python3-venv unzip xz-utils \
    && rm -rf /var/lib/apt/lists/*

# protoc: the code generator needs it. The .proto files use Edition 2023, which
# needs protoc 27 or newer.
ARG PROTOC_VERSION=31.0
ARG PROTOC_SHA256=24e2ed32060b7c990d5eb00d642fde04869d7f77c6d443f609353f097799dd42
RUN curl -fsSL -o /tmp/protoc.zip \
        "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-x86_64.zip" \
    && echo "${PROTOC_SHA256}  /tmp/protoc.zip" | sha256sum -c - \
    && unzip -q -o /tmp/protoc.zip -d /usr/local bin/protoc 'include/*' \
    && rm -f /tmp/protoc.zip

# Node runs the kit-wasm smoke test (scripts/wasm-smoke.sh).
ARG NODE_VERSION=22.11.0
ARG NODE_SHA256=83bf07dd343002a26211cf1fcd46a9d9534219aad42ee02847816940bf610a72
RUN curl -fsSL -o /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --exclude='*.md' --exclude=LICENSE \
    && rm -f /tmp/node.tar.xz

# rustfmt and clippy for the lint gates. The wasm32 target is for the kit-client
# build and the generated-code check. The dated nightly toolchain is only for
# cargo-fuzz, which needs sanitizer flags. Its date appears in cloudbuild/ci.yaml
# too, and scripts/test-ci-gates.py checks that both agree.
RUN rustup component add rustfmt clippy \
    && rustup target add wasm32-unknown-unknown \
    && rustup toolchain install nightly-2026-10-01 --profile minimal

# Prebuilt tool binaries, each at one exact version. cargo-binstall resolves them
# once here and the image keeps them. Rebuild the image to change a version.
ARG ACTIONLINT_VERSION=1.7.12
ARG ACTIONLINT_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
ARG BINSTALL_INSTALLER_COMMIT=851112458b5f28a29e5bc14a690c3f283d9dcc6f
RUN curl -L --proto '=https' --tlsv1.2 -sSf \
        "https://raw.githubusercontent.com/cargo-bins/cargo-binstall/${BINSTALL_INSTALLER_COMMIT}/install-from-binstall-release.sh" | bash \
    && cargo binstall -y \
        cargo-nextest@0.9.145 \
        sccache@0.17.0 \
        cargo-deny@0.20.2 \
        cargo-audit@0.22.2 \
        cargo-geiger@0.13.0 \
        cargo-about@0.9.1 \
        cargo-fuzz@0.13.2 \
        b3sum@1.8.7 \
        wasm-bindgen-cli@0.2.129 \
    && curl -fsSL -o /tmp/actionlint.tar.gz "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz" \
    && echo "${ACTIONLINT_SHA256}  /tmp/actionlint.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/actionlint.tar.gz -C /usr/local/bin actionlint \
    && rm -f /tmp/actionlint.tar.gz \
    && rm -rf "${CARGO_HOME:-/usr/local/cargo}/registry"
